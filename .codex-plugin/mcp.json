{
  "mcpServers": {
    "ismail": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/newsbubbles/ismail",
        "ismail",
        "mcp"
      ],
      "env": {
        "PYTHONWARNINGS": "ignore"
      },
      "startup_timeout_sec": 300
    }
  }
}
